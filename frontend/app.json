{
  "expo": {
    "name": "Surrey Opticians",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "surreyopticians",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.surreyopticians.xkx2pz",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your loyalty account with Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B6E75"
      },
      "package": "com.emergent.surreyopticians.xkx2pz"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your loyalty account with Face ID"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
