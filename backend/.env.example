# Surrey Opticians loyalty API — configuration template.
# Copy to backend/.env and fill in. Never commit the real .env.

# --- Database (required) --------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=surrey_opticians
MONGO_TIMEOUT_MS=5000

# --- Sessions (required in production) ------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Leave unset in development and a throwaway key is generated on each boot,
# which signs everyone out whenever the server restarts.
JWT_SECRET=
JWT_TTL_DAYS=30

# --- One-time codes -------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_HOUR=5

# MUST be false in production. When true the sign-in code is returned in the
# API response and shown on screen — convenient for the prototype, an open
# door to every account otherwise.
EXPOSE_DEV_OTP=true

# --- SMS ------------------------------------------------------------------
# console = write the code to the server log (development).
# twilio  = send it for real; needs the three TWILIO_ values below.
SMS_PROVIDER=console
SMS_SENDER=SurreyOpt
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Till / staff API -----------------------------------------------------
# Shared secret the practice's till presents as the X-Staff-Key header.
# Unset means the staff endpoints refuse every request.
STAFF_API_KEY=

# --- Loyalty scheme -------------------------------------------------------
SPEND_PER_POINT_PENCE=1000
POINTS_PER_REWARD=10
VOUCHER_VALUE_PENCE=1000
VOUCHER_TTL_MONTHS=12
REFERRAL_BONUS_POINTS=1

# Welcome offer, issued once when a member first signs up. One per member ever.
# Set SIGNUP_VOUCHER_ENABLED=false to stop issuing it to new members; vouchers
# already issued keep working.
SIGNUP_VOUCHER_ENABLED=true
SIGNUP_VOUCHER_PERCENT=20
SIGNUP_VOUCHER_TTL_MONTHS=12

# --- CORS -----------------------------------------------------------------
# Comma-separated origins. "*" is development only — set the real app origins
# before going live.
CORS_ORIGINS=*

# --- Demo data ------------------------------------------------------------
# Seeds the Sarah Whitfield sample account on boot if it has no transactions.
# Turn off for the practice's real deployment.
SEED_DEMO_DATA=true
DEMO_MOBILE=+447712045589

# --- Apple / Google Wallet ------------------------------------------------
# See backend/WALLET_SETUP.md. Drop the files in backend/secrets/.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_P12_PATH=
APPLE_P12_PASSWORD=
APPLE_WWDR_PATH=
GOOGLE_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
